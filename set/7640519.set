[Sections]
AddReg=OVT.7640519.Setting

[OVT.7640519.Setting]
;this data is for check camera type, there are four data segment 
;1. I2C subAddress, 
;2. which register driver should read
;3. value mask
;4. register value
;HKR,%7640519Set%, OneChannelCheck,1, 55, 00, 80
HKR,%7640519Set%, VersionCheck,1, 42, 0a, ff, 76
HKR,%7640519Set%, MinorVersionCheck,1, 42, 0b, ff, 45
HKR,%7640519Set%, ResetCamera,1, 12, 80, ff
HKR,%7640519Set%, CameraName,,Ov7640519
HKR,%7640519Set%, SensorWidth,0x10001, 640
HKR,%7640519Set%, SensorHeight,0x10001, 480
HKR,%7640519Set%, CurrentFormat,0x10001, 0x32024024
HKR,%7640519Set%, CurrentFrameRate,0x10001, 30

;USB controller register setting, only the registers that need change should 
;set here, every three value form one group
;Index, Value, Mask

HKR,%7640519Set%,UsbSetting,1, 5d,03,ff, 53,9b,9b, 54,0f,ff, a2,20,ff, a3,18,ff, a4,04,ff, a5,28,ff, 37,00,ff, 55,02,ff, 20,0d,ff, 21,38,ff, 22,1d,ff, 17,50,ff, 37,00,ff, 40,ff,ff, 46,00,ff

;Index, Value, Mask
HKR,%7640519Set%,CameraSetting,1, 12,80,ff, 03,a4,ff, 04,30,ff, 05,88,ff, 06,60,ff, 11,00,ff, 12,05,ff, 13,a3,ff, 14,24,ff, 15,14,ff, 20,d0,ff, 23,de,ff, 24,30,ff, 25,7a,ff, 26,a2,ff, 27,e2,ff, 28,20,ff, 2a,90,ff, 2b,00,ff, 2d,05,ff, 2f,9d,ff, 30,00,ff, 31,c4,ff, 60,a6,ff, 61,e0,ff, 62,88,ff, 63,11,ff, 64,89,ff, 65,00,ff, 67,94,ff, 68,7a,ff, 69,08,ff, 6c,11,ff, 6d,33,ff, 6e,22,ff, 6f,00,ff, 74,20,ff, 75,06,ff, 77,c4,ff, 1f,41,ff

HKR,%7640519Adj%,EnableLowLightControl,0x10001,0
HKR,%7640519Adj%,ClockUpTh,0x10001,150
HKR,%7640519Adj%,ClockDownTh,0x10001,60
HKR,%7640519Adj%,CheckTime,0x10001,40
HKR,%7640519Adj%,ClockUpCamRegs,1,20,00,08,28,00,02,12,00,04,12,04,04
HKR,%7640519Adj%,ClockDownCamRegs,1,20,08,08,28,02,02,12,00,04,12,04,04
HKR,%7640519Adj%,ExposureCheck,1,10,7f

HKR,%7640519DP%,EnVideoYUVProc,0x10001,0
HKR,%7640519DP%,EnVideoRGBProc,0x10001,0
HKR,%7640519DP%,EnStillYUVProc,0x10001,0
HKR,%7640519DP%,EnStillRGBProc,0x10001,0
HKR,%7640519DP%,StillSharpness,0x10001,2   ; range  0 ~ 8
HKR,%7640519DP%,DisableAutoLFCheck,0x10001,0
; Enable to remove Flicker
HKR,%7640519DP%,SaveLastFrame,0x10001,1
HKR,%7640519DP%,EnableSwQC,0x10001,0

HKR,%7640519STIYUV%, UsbSetting,1, ff,00,ff

HKR,%7640519STIRAW%, UsbSetting,1, ff,00,ff

HKR,%7640519DP%, EnVideoYUVProc,0x10001,0
HKR,%7640519DP%, EnVideoRGBProc,0x10001,0
HKR,%7640519DP%, EnStillYUVProc,0x10001,0
HKR,%7640519DP%, EnStillRGBProc,0x10001,0
HKR,%7640519DP%, StillSharpness,0x10001,3   ; range  0 ~ 8
; Enable to remove Flicker by takayosm
;HKR,%7640519DP%, DisableAutoLFCheck,0x10001,1
HKR,%7640519DP%, DisableAutoLFCheck,0x10001,0
HKR,%7640519DP%, SaveLastFrame,0x10001,1

