[Sections]
AddReg=OVT.7620e519.Setting

[OVT.7620e519.Setting]
;this data is for check camera type, there are four data segment 
;1. I2C subAddress, 
;2. which register driver should read
;3. value mask
;4. register value
;HKR,%7620e519Set%, OneChannelCheck,1, 55, 00, 80
HKR,%7620e519Set%, VersionCheck,1, 42, 29, ff, 01
HKR,%7620e519Set%, MinorVersionCheck,1, 42, 17, ff, 2f
HKR,%7620e519Set%, ResetCamera,1, 12, 80, ff
HKR,%7620e519Set%, CameraName,,Ov7620e519
HKR,%7620e519Set%, SensorWidth,0x10001, 640
HKR,%7620e519Set%, SensorHeight,0x10001, 480
HKR,%7620e519Set%, CurrentFormat,0x10001, 0x32024024
HKR,%7620e519Set%, CurrentFrameRate,0x10001, 30

;USB controller register setting, only the registers that need change should 
;set here, every three value form one group
;Index, Value, Mask

HKR,%7620e519Set%,UsbSetting,1, 5d,03,ff, 53,9b,9b, 54,0f,ff, a2,20,ff, a3,18,ff, a4,04,ff, a5,28,ff, 37,00,ff, 55,02,ff, 22,1d,ff, 17,50,ff, 37,00,ff, 40,ff,ff, 46,00,ff

;Index, Value, Mask
HKR,%7620e519Set%,CameraSetting,1, 12,80,ff, 00,00,ff, 01,80,ff, 02,80,ff, 03,b0,ff, 06,80,ff, 07,00,ff, 0c,24,ff, 0d,24,ff, 11,01,ff, 12,24,ff, 13,01,ff, 15,01,ff, 16,03,ff, 17,2f,ff, 18,cf,ff, 19,06,ff, 1a,f5,ff, 1b,00,ff, 20,18,ff, 21,80,ff, 22,80,ff, 23,00,ff, 26,a2,ff, 27,ea,ff, 29,00,ff, 2a,80,ff, 2b,00,ff, 2c,88,ff, 2d,d5,ff, 2e,80,ff, 2f,44,ff, 60,27,ff, 61,02,ff, 62,5f,ff, 63,cc,ff, 64,57,ff, 65,83,ff, 66,55,ff, 67,b0,ff, 68,cf,ff, 69,76,ff, 6a,22,ff, 6b,00,ff, 6c,02,ff, 6d,44,ff, 6e,40,ff, 6f,1d,ff, 70,8B,ff, 71,00,ff, 72,14,ff, 73,54,ff, 74,00,ff, 75,8e,ff, 76,00,ff, 77,ff,ff, 78,80,ff, 79,80,ff, 7a,80,ff, 7b,e2,ff, 7c,00,ff, 12,20,ff, 12,24,ff

HKR,%7620e519Adj%,EnableLowLightControl,0x10001,1
HKR,%7620e519Adj%,ClockUpTh,0x10001,150
HKR,%7620e519Adj%,ClockDownTh,0x10001,60
HKR,%7620e519Adj%,CheckTime,0x10001,40
;Modified by Jeff Shih @08/16/2000
HKR,%7620e519Adj%, ClockUpCamRegs,1,20,00,08,28,00,02,12,00,04,12,04,04
HKR,%7620e519Adj%, ClockDownCamRegs,1,20,08,08,28,02,02,12,00,04,12,04,04
;End of Modification
HKR,%7620e519Adj%,ExposureCheck,1,10,7f

HKR,%7620e519DP%,EnVideoYUVProc,0x10001,0
HKR,%7620e519DP%,EnVideoRGBProc,0x10001,0
HKR,%7620e519DP%,EnStillYUVProc,0x10001,0
HKR,%7620e519DP%,EnStillRGBProc,0x10001,0
HKR,%7620e519DP%,StillSharpness,0x10001,2   ; range  0 ~ 8
HKR,%7620e519DP%,DisableAutoLFCheck,0x10001,0
; Enable to remove Flicker by takayosm
HKR,%7620e519DP%,SaveLastFrame,0x10001,1
HKR,%7620e519DP%,EnableSwQC,0x10001,0


;HKR,%7620e519STIYUV%, CameraSetting,1, ff,00,ff

;Modified by Jeff @05/13/00, @06/08/00
;Original Setting:
;HKR,%7620e519STIYUV%, UsbSetting,1, ff,00,ff
;No Setting necessary in OV518, if using YUV 422
;The using of 422 or 420 will be set in each format where is needed
;Default is transmission YUV 422
;End of Modification


HKR,%7620e519STIYUV%, UsbSetting,1, ff,00,ff

HKR,%7620e519STIRAW%, UsbSetting,1, ff,00,ff

;HKR,%7620e519UVTest%, CameraSetting,1, ;12,26,ff,13,20,01,10,00,ff,00,30,ff,03,ff,ff,28,02,02

;Modified by Jeff @05/13/00
;Original Setting:
;HKR,%7620e519STIRAW%, UsbSetting,1, ff,00,ff
;No Setting necessary in OV518, if using YUV 422
;The using of 422 or 420 will be set in each format where is needed
;Default is transmission YUV 422
;End of Modification

;HKR,%7620e519DP%, LogFileName,,logo352.bmp
HKR,%7620e519DP%, EnVideoYUVProc,0x10001,0
HKR,%7620e519DP%, EnVideoRGBProc,0x10001,0
HKR,%7620e519DP%, EnStillYUVProc,0x10001,0
HKR,%7620e519DP%, EnStillRGBProc,0x10001,0
HKR,%7620e519DP%, StillSharpness,0x10001,3   ; range  0 ~ 8
; Enable to remove Flicker by takayosm
;HKR,%7620e519DP%, DisableAutoLFCheck,0x10001,1
HKR,%7620e519DP%, DisableAutoLFCheck,0x10001,0
HKR,%7620e519DP%, SaveLastFrame,0x10001,1

