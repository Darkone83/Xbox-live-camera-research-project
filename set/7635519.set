[Sections]
AddReg=OVT.7635519.Setting

[OVT.7635519.Setting]
;this data is for check camera type, there are four data segment 
;1. I2C subAddress, 
;2. which register driver should read
;3. value mask
;4. register value
;HKR,%7635519Set%, OneChannelCheck,1, 55, 00, 80
HKR,%7635519Set%, VersionCheck,1, 42, 0a, ff, 76
HKR,%7635519Set%, MinorVersionCheck,1, 42, 0b, fe, 30
HKR,%7635519Set%, ResetCamera,1, 12, 80, ff
HKR,%7635519Set%, CameraName,,Ov7635519
HKR,%7635519Set%, SensorWidth,0x10001, 640
HKR,%7635519Set%, SensorHeight,0x10001, 480
HKR,%7635519Set%, CurrentFormat,0x10001, 0x32024024
HKR,%7635519Set%, CurrentFrameRate,0x10001, 30

;USB controller register setting, only the registers that need change should 
;set here, every three value form one group
;Index, Value, Mask

HKR,%7635519Set%,UsbSetting,1, 5d,03,ff, 53,9b,9b, 54,0f,ff, a2,20,ff, a3,18,ff, a4,04,ff, a5,28,ff, 37,00,ff, 55,02,ff, 20,01,ff, 21,38,ff, 22,1d,ff, 17,50,ff, 37,00,ff, 40,ff,ff, 46,00,ff

;Index, Value, Mask
HKR,%7635519Set%,CameraSetting,1, 12,80,ff, 00,00,ff, 01,80,ff, 02,80,ff, 03,c0,ff, 04,2a,ff, 05,37,ff, 06,80,ff, 0A,76,ff, 0B,31,ff, 0c,24,ff, 0d,20,ff, 11,01,ff, 12,24,ff, 13,a3,ff, 14,84,ff, 15,15,ff, 16,03,ff, 17,1c,ff, 18,cf,ff, 19,06,ff, 1a,f6,ff, 1b,04,ff, 1e,00,ff, 1f,00,ff, 20,54,ff, 23,ce,ff, 24,4a,ff, 25,7a,ff, 26,a2,ff, 27,8a,ff, 28,20,ff, 29,30,ff, 2a,80,ff, 2b,00,ff, 2c,ac,ff, 2d,05,ff, 2e,80,ff, 2f,3d,ff, 30,24,ff, 31,00,ff, 32,88,ff, 33,08,ff, 4c,00,ff, 4d,00,ff, 60,A3,ff, 61,c2,ff, 62,f3,ff, 63,75,ff, 64,ff,ff, 65,00,ff, 66,55,ff, 67,92,ff, 68,a0,ff, 69,3b,ff, 6b,00,ff, 6c,33,ff, 6d,33,ff, 6e,22,ff, 6f,84,ff, 70,0b,ff, 71,00,ff, 72,10,ff, 73,50,ff, 74,60,ff, 75,0e,ff, 76,00,ff, 77,a5,ff, 78,80,ff, 79,80,ff, 7a,80,ff, 7c,00,ff, 7d,f7,ff, 7e,00,ff, 7f,00,ff, 13,a3,ff, 20,54,ff

HKR,%7635519Adj%,EnableLowLightControl,0x10001,0
HKR,%7635519Adj%,ClockUpTh,0x10001,150
HKR,%7635519Adj%,ClockDownTh,0x10001,60
HKR,%7635519Adj%,CheckTime,0x10001,40
HKR,%7635519Adj%,ClockUpCamRegs,1,20,00,08,28,00,02,12,00,04,12,04,04
HKR,%7635519Adj%,ClockDownCamRegs,1,20,08,08,28,02,02,12,00,04,12,04,04
HKR,%7635519Adj%,ExposureCheck,1,10,7f

HKR,%7635519DP%,EnVideoYUVProc,0x10001,0
HKR,%7635519DP%,EnVideoRGBProc,0x10001,0
HKR,%7635519DP%,EnStillYUVProc,0x10001,0
HKR,%7635519DP%,EnStillRGBProc,0x10001,0
HKR,%7635519DP%,StillSharpness,0x10001,2   ; range  0 ~ 8
HKR,%7635519DP%,DisableAutoLFCheck,0x10001,0
; Enable to remove Flicker by takayosm
HKR,%7635519DP%,SaveLastFrame,0x10001,1
HKR,%7635519DP%,EnableSwQC,0x10001,0

HKR,%7635519STIYUV%, UsbSetting,1, ff,00,ff

HKR,%7635519STIRAW%, UsbSetting,1, ff,00,ff

HKR,%7635519DP%, EnVideoYUVProc,0x10001,0
HKR,%7635519DP%, EnVideoRGBProc,0x10001,0
HKR,%7635519DP%, EnStillYUVProc,0x10001,0
HKR,%7635519DP%, EnStillRGBProc,0x10001,0
HKR,%7635519DP%, StillSharpness,0x10001,3   ; range  0 ~ 8
; Enable to remove Flicker by takayosm
;HKR,%7635519DP%, DisableAutoLFCheck,0x10001,1
HKR,%7635519DP%, DisableAutoLFCheck,0x10001,0
HKR,%7635519DP%, SaveLastFrame,0x10001,1

