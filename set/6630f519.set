[Sections]
AddReg=OVT.6630f519.Setting

[OVT.6630f519.Setting]
;this data is for check camera type, there are four data segment 
;1. I2C subAddress, 
;2. which register driver should read
;3. value mask
;4. register value

HKR,%6630f519Set%, OneChannelCheck,1, 55, 00, 80
HKR,%6630f519Set%, VersionCheck,1, C0, 29, ff, 03
;HKR,%6630f519Set%, MinorVersionCheck,1, 42, 15, ff, 03
HKR,%6630f519Set%, ResetCamera,1, 12, 80, ff
HKR,%6630f519Set%, CameraName,,Ov6630f519
HKR,%6630f519Set%, SensorWidth,0x10001, 352
HKR,%6630f519Set%, SensorHeight,0x10001, 288
HKR,%6630f519Set%, CurrentFormat,0x10001, 0x32024012
HKR,%6630f519Set%, CurrentFrameRate,0x10001, 30


;USB controller register setting, only the registers that need change should 
;set here, every three value form one group
;Index, Value, Mask

HKR,%6630f519Set%,UsbSetting,1, 5d,03,ff, 53,9b,9b, 54,0f,ff, a2,20,ff, a3,18,ff, a4,04,ff, a5,18,ff, 37,00,ff, 55,02,ff, 22,1d,ff, 17,50,ff, 37,00,ff, 40,ff,ff, 46,00,ff, 59,04,ff

;Index, Value, Mask
HKR,%6630f519Set%,CameraSetting,1, 12,80,FF, 03,C0,FF, 05,0A,FF, 0C,24,FF, 0D,24,FF, 0E,20,FF, 0F,15,FF, 11,00,FF, 12,24,FF, 13,01,FF, 14,84,FF, 15,00,FF, 16,03,FF, 17,38,FF, 18,EA,FF, 19,04,FF, 1A,93,FF, 1B,00,FF, 1C,7F,FF, 1D,A2,FF, 1E,C4,FF, 1F,04,FF, 20,20,FF, 21,10,FF, 22,88,FF, 23,C0,FF, 24,43,FF, 25,8a,FF, 26,B2,FF, 27,A2,FF, 28,00,FF, 29,00,FF, 2A,84,FF, 2B,A8,FF, 2C,a0,FF, 2D,95,FF, 2E,88,ff, 33,26,FF, 34,03,FF, 36,8F,FF, 37,80,FF, 38,83,FF, 39,80,FF, 3A,0F,FF, 3B,3C,FF, 3C,1a,FF, 3d,80,ff, 3E,80,FF, 3F,0E,FF, 40,00,FF, 41,00,FF, 42,80,FF, 43,3F,FF, 44,80,FF, 45,20,FF, 46,20,FF, 47,80,FF, 48,7F,FF, 49,00,FF, 4A,00,FF, 4B,80,FF, 4C,D0,FF, 4D,10,FF, 4E,40,FF, 4F,07,FF, 50,FF,FF, 54,23,FF, 55,dd,FF, 56,12,FF, 57,81,FF, 58,75,FF, 59,01,FF, 5A,2C,FF, 5B,0F,FF, 5C,10,FF, 3d,80,ff, 27,a6,ff, 12,20,FF, 12,24,FF

HKR,%6630f519Adj%,EnableLowLightControl,0x10001,0
HKR,%6630f519Adj%,ClockUpTh,0x10001,150
HKR,%6630f519Adj%,ClockDownTh,0x10001,60
HKR,%6630f519Adj%,CheckTime,0x10001,35
HKR,%6630f519Adj%, ClockUpCamRegs,1,20,00,08,5a,2c,40,28,00,02
HKR,%6630f519Adj%, ClockDownCamRegs,1,20,08,08,28,02,02,5a,7c,40
HKR,%6630f519Adj%,ExposureCheck,1,10,9a

HKR,%6630f519DP%,EnVideoYUVProc,0x10001,0
HKR,%6630f519DP%,EnVideoRGBProc,0x10001,0
HKR,%6630f519DP%,EnStillYUVProc,0x10001,0
HKR,%6630f519DP%,EnStillRGBProc,0x10001,0
HKR,%6630f519DP%,StillSharpness,0x10001,3   ; range  0 ~ 8
; Enable to remove flicker by takayosm
;HKR,%6630f519DP%,DisableAutoLFCheck,0x10001,1
HKR,%6630f519DP%,DisableAutoLFCheck,0x10001,0
HKR,%6630f519DP%,SaveLastFrame,0x10001,1
HKR,%6630f519DP%,EnableSwQC,0x10001,0


;HKR,%6630f519STIYUV%, CameraSetting,1, ff,00,ff

;Modified by Jeff @05/13/00, @06/08/00
;Original Setting:
;HKR,%6630f519STIYUV%, UsbSetting,1, ff,00,ff
;No Setting necessary in OV518, if using YUV 422
;The using of 422 or 420 will be set in each format where is needed
;Default is transmission YUV 422
;End of Modification


HKR,%6630f519STIYUV%, UsbSetting,1, ff,00,ff

HKR,%6630f519STIRAW%, UsbSetting,1, ff,00,ff

;HKR,%6630f519UVTest%, CameraSetting,1, ;12,26,ff,13,20,01,10,00,ff,00,30,ff,03,ff,ff,28,02,02

;Modified by Jeff @05/13/00
;Original Setting:
;HKR,%6630f519STIRAW%, UsbSetting,1, ff,00,ff
;No Setting necessary in OV518, if using YUV 422
;The using of 422 or 420 will be set in each format where is needed
;Default is transmission YUV 422
;End of Modification

;HKR,%6630f519DP%, LogFileName,,logo352.bmp
HKR,%6630f519DP%, EnVideoYUVProc,0x10001,0
HKR,%6630f519DP%, EnVideoRGBProc,0x10001,0
HKR,%6630f519DP%, EnStillYUVProc,0x10001,0
HKR,%6630f519DP%, EnStillRGBProc,0x10001,0
HKR,%6630f519DP%, StillSharpness,0x10001,3   ; range  0 ~ 8
; Enable to remove flicker by takayosm
;HKR,%6630f519DP%, DisableAutoLFCheck,0x10001,1
HKR,%6630f519DP%, DisableAutoLFCheck,0x10001,0
HKR,%6630f519DP%, SaveLastFrame,0x10001,1

